# Same Circle developer account as daemon/.env (CIRCLE_API_KEY + CIRCLE_ENTITY_SECRET
# can be copied straight across) — but a DEDICATED wallet, provisioned via
# `npm run wallet:setup`, so the buyer has its own separate on-chain identity from
# Patron's treasury.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
BUYER_WALLET_ID=
BUYER_WALLET_ADDRESS=
CIRCLE_BLOCKCHAIN=ARC-TESTNET

ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Where Patron's daemon is listening
PATRON_URL=http://localhost:8787
