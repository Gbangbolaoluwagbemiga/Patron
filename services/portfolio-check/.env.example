# Same Circle developer account as daemon/.env — copy CIRCLE_API_KEY and
# CIRCLE_ENTITY_SECRET across — but its OWN dedicated wallet (run
# `npm run wallet:setup`), so this is a genuinely separate seller Patron pays,
# not Patron paying itself.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
SERVICE_WALLET_ID=
SERVICE_WALLET_ADDRESS=
CIRCLE_BLOCKCHAIN=ARC-TESTNET

ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
ARC_CHAIN_ID=5042002
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

PORTFOLIO_CHECK_FEE=0.01
PORT=8788
