# Arc Testnet
VITE_ARC_RPC_URL=https://rpc.drpc.testnet.arc.network
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_EXPLORER_URL=https://testnet.arcscan.app

# SecureFlow contract — Patron calls this, does NOT deploy its own
VITE_SECUREFLOW_CONTRACT_ADDRESS=0x6142bf4855D4F9dbC1cD8109377d4F4E2AF1ab59
VITE_USDC_TOKEN_CONTRACT=0x3600000000000000000000000000000000000000

# SecureFlow Subgraph (v3) — same as SecureFlow, Patron reads from it
VITE_GRAPH_URL=https://api.goldsky.com/api/public/project_cmpyopkeb3cxh01v51s4wg5nc/subgraphs/secureflow/v3/gn

# Anthropic (Claude) — for brief generation, application scoring, work review
VITE_ANTHROPIC_API_KEY=

# Circle Gateway — gasless instant USDC payments
VITE_CIRCLE_API_KEY=
VITE_GATEWAY_URL=

# Agent wallet — the autonomous client wallet (separate from human wallet)
VITE_AGENT_WALLET_ADDRESS=
VITE_AGENT_PRIVATE_KEY=   # NEVER commit this

# Reown (WalletConnect) — for human wallet connection to fund agent
VITE_REOWN_PROJECT_ID=
